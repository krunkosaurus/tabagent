{
  "name": "tabagent",
  "version": "0.2.1",
  "private": true,
  "description": "Universal AI Browser Agent Chrome Extension (MV3) with Z.AI coding-plan support",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "node build.mjs",
    "clean": "rm -rf dist build",
