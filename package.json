    "mcp": "node mcp/server.mjs"
  },
  "license": "MIT",
  "type": "module",
  "devDependencies": {
    "@types/chrome": "^0.0.287",
    "esbuild": "0.28.2",
    "playwright": "1.63.0",
    "typescript": "^5.7.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "ws": "8.21.3"
  },
  "engines": {
    "node": ">=22"
  }
}
